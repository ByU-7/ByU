---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('field-notes');
notes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Things I Discover | Bayu Distira">
  <div class="py-16 max-w-2xl mx-auto">
    <div class="mb-16">
      <h1 class="text-4xl font-serif font-bold text-brand-text mb-4">Things I Discover</h1>
      <p class="font-sans text-brand-text/60">Small things I find out, answers to random questions, and digital notes.</p>
    </div>
    
    <div class="space-y-12">
      {notes.map((note) => (
        <article class="border-l-2 border-brand-accent/20 pl-6">
          <h2 class="text-xl font-serif font-bold text-brand-text mb-2">{note.data.title}</h2>
          <p class="text-xs font-sans uppercase text-brand-text/40 mb-4">
            {new Date(note.data.pubDate).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </p>
          <div class="font-sans text-brand-text/80 text-sm">
            {note.body}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
