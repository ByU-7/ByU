---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const work = await getCollection('work');
const writing = await getCollection('writing');

work.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
writing.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestWork = work[0];
const latestWriting = writing[0];
---

<Layout title="Bayu Distira | I Wonder, So I Wander">
  <div class="relative w-full">
    
    <!-- HERO SECTION -->
    <section class="sticky top-[80px] md:top-[100px] z-10 bg-brand-bg flex flex-col items-center justify-center text-center min-h-[60vh] pb-24 pt-12">
      <h1 class="text-3xl md:text-4xl font-serif font-bold tracking-widest text-brand-text mb-6">
        ByU
      </h1>
      <p class="text-4xl md:text-5xl font-serif italic text-brand-accent mb-8">
        I Wonder, So I Wander.
      </p>
      <p class="text-lg md:text-xl font-sans text-brand-text/70 max-w-2xl leading-relaxed">
        A personal archive of things I build, places I wander, and questions I cannot stop wondering about.
      </p>
    </section>

    <!-- EXPLORE SECTION -->
    <section class="sticky top-[90px] md:top-[110px] z-20 bg-[#e6e2d6] border border-brand-text/10 rounded-t-3xl shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)] min-h-[70vh] px-6 md:px-12 py-16 flex flex-col">
      <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase mb-12 text-center">
        Explore
      </h2>
      <div class="flex flex-col flex-grow">
        <a href="/work" class="flex justify-between items-center py-8 border-b border-brand-text/10 group">
          <div class="flex items-center gap-6">
            <span class="text-xs font-sans text-brand-text/30 font-bold">01</span>
            <span class="text-2xl font-serif text-brand-text group-hover:text-brand-accent transition-colors">Things I Build</span>
          </div>
          <span class="text-brand-text/30 group-hover:text-brand-accent transition-colors">&rarr;</span>
        </a>
        <a href="/writing" class="flex justify-between items-center py-8 border-b border-brand-text/10 group">
          <div class="flex items-center gap-6">
            <span class="text-xs font-sans text-brand-text/30 font-bold">02</span>
            <span class="text-2xl font-serif text-brand-text group-hover:text-brand-accent transition-colors">Things I Write</span>
          </div>
          <span class="text-brand-text/30 group-hover:text-brand-accent transition-colors">&rarr;</span>
        </a>
        <a href="/wander" class="flex justify-between items-center py-8 border-b border-brand-text/10 group">
          <div class="flex items-center gap-6">
            <span class="text-xs font-sans text-brand-text/30 font-bold">03</span>
            <span class="text-2xl font-serif text-brand-text group-hover:text-brand-accent transition-colors">Things I Wander</span>
          </div>
          <span class="text-brand-text/30 group-hover:text-brand-accent transition-colors">&rarr;</span>
        </a>
        <a href="/notes" class="flex justify-between items-center py-8 group">
          <div class="flex items-center gap-6">
            <span class="text-xs font-sans text-brand-text/30 font-bold">04</span>
            <span class="text-2xl font-serif text-brand-text group-hover:text-brand-accent transition-colors">Things I Discover</span>
          </div>
          <span class="text-brand-text/30 group-hover:text-brand-accent transition-colors">&rarr;</span>
        </a>
      </div>
    </section>

    <!-- LATEST SECTION -->
    <section class="sticky top-[100px] md:top-[120px] z-30 bg-[#ded9cb] border border-brand-text/10 rounded-t-3xl shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.15)] min-h-[70vh] px-6 md:px-12 py-16 flex flex-col mb-12">
      <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase mb-12 text-center">
        Latest
      </h2>
      <div class="space-y-16 flex-grow">
        {latestWriting && (
          <a href={`/writing/${latestWriting.id}`} class="block group border-b border-brand-text/10 pb-12">
            <h3 class="text-3xl font-serif font-bold text-brand-text group-hover:text-brand-accent transition-colors mb-3">{latestWriting.data.title}</h3>
            <p class="font-serif italic text-brand-text/70 mb-4 text-lg">{latestWriting.data.description}</p>
            <p class="text-xs font-sans uppercase tracking-widest text-brand-text/50">{latestWriting.data.category} &middot; {new Date(latestWriting.data.pubDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</p>
          </a>
        )}
        
        {latestWork && (
          <a href={`/work/${latestWork.id}`} class="block group">
            <h3 class="text-3xl font-serif font-bold text-brand-text group-hover:text-brand-accent transition-colors mb-3">{latestWork.data.title}</h3>
            <p class="font-serif italic text-brand-text/70 mb-4 text-lg">{latestWork.data.description}</p>
            <p class="text-xs font-sans uppercase tracking-widest text-brand-text/50">Project &middot; {new Date(latestWork.data.pubDate).toLocaleDateString('en-US', { year: 'numeric' })}</p>
          </a>
        )}
      </div>
    </section>

  </div>
</Layout>
