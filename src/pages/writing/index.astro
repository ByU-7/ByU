---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const writing = await getCollection('writing');
writing.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = writing.find(p => p.data.isFeatured) || writing[0];
const allPosts = writing.filter(p => p.id !== featuredPost?.id);
---

<Layout title="Writing | Bayu Distira">
  <div class="py-16 max-w-4xl mx-auto px-4 md:px-0">
    <div class="mb-16 text-center border-b border-brand-text/10 pb-16">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-text mb-6">WRITING</h1>
      <p class="font-sans text-brand-text/60 text-lg">Essays, opinions, reflections, and questions worth sitting with.</p>
      
      <div class="mt-12 flex flex-wrap justify-center gap-6 text-sm font-sans tracking-widest uppercase text-brand-text/40" id="filter-container">
        <button class="filter-btn text-brand-text hover:text-brand-text cursor-pointer transition-colors" data-filter="All">All</button>
        <button class="filter-btn hover:text-brand-text cursor-pointer transition-colors" data-filter="Essay">Essays</button>
        <button class="filter-btn hover:text-brand-text cursor-pointer transition-colors" data-filter="Opinion">Opinions</button>
        <button class="filter-btn hover:text-brand-text cursor-pointer transition-colors" data-filter="Reflection">Reflections</button>
        <button class="filter-btn hover:text-brand-text cursor-pointer transition-colors" data-filter="Idea">Ideas</button>
      </div>
    </div>
    
    <div class="mb-24" id="featured-section">
      <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase mb-8 text-center md:text-left">Featured</h2>
      {featuredPost && (
        <a href={`/writing/${featuredPost.id}/`} class="block group">
          <article class="bg-[#e6e2d6] border border-brand-text/10 p-8 md:p-12 shadow-[0_10px_30px_-15px_rgba(0,0,0,0.1)] hover:shadow-[0_15px_40px_-15px_rgba(0,0,0,0.15)] hover:-translate-y-1 transition-all duration-300 rounded-lg">
            <h3 class="text-3xl md:text-4xl font-serif font-bold text-brand-text mb-4 group-hover:text-brand-accent transition-colors">{featuredPost.data.title}</h3>
            <p class="font-sans text-brand-text/70 text-lg mb-8 leading-relaxed max-w-2xl">{featuredPost.data.description}</p>
            <div class="flex items-center gap-2 text-xs font-sans tracking-[0.2em] uppercase text-brand-text/50">
              <span class="font-bold text-brand-accent">{featuredPost.data.type}</span>
              {featuredPost.data.tags && featuredPost.data.tags.length > 0 && (
                <>
                  <span>&middot;</span>
                  <span>{featuredPost.data.tags.join(', ')}</span>
                </>
              )}
            </div>
          </article>
        </a>
      )}
    </div>

    <div>
      <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase border-b border-brand-text/10 pb-4 mb-8">All Writings</h2>
      <div class="space-y-4">
        {allPosts.map((post) => (
          <a href={`/writing/${post.id}/`} class="post-item group block py-6 border-b border-brand-text/5 hover:bg-white/30 transition-colors px-4 -mx-4 rounded-lg" data-type={post.data.type}>
            <article class="grid grid-cols-1 md:grid-cols-[1fr_200px] gap-4 md:items-center">
              <div>
                <div class="flex items-center gap-2 text-[10px] font-sans tracking-[0.2em] uppercase text-brand-text/50 mb-2">
                  <span class="font-bold text-brand-accent">{post.data.type}</span>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <>
                      <span>&middot;</span>
                      <span>{post.data.tags.join(', ')}</span>
                    </>
                  )}
                </div>
                <h3 class="text-2xl font-serif font-bold text-brand-text mb-2 group-hover:text-brand-accent transition-colors">{post.data.title}</h3>
                <p class="font-sans text-brand-text/60 text-sm max-w-2xl">{post.data.description}</p>
              </div>
              <div class="text-left md:text-right">
                <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-brand-text/40">
                  {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                    month: 'short', day: 'numeric', year: 'numeric'
                  })}
                  <br class="hidden md:block" />
                  <span class="md:hidden"> &middot; </span>
                  <span class="mt-1 inline-block">5 min read</span>
                </p>
              </div>
            </article>
          </a>
        ))}
      </div>

      {/* Empty State */}
      <div id="empty-state" class="hidden text-center py-24">
        <p class="font-serif italic text-brand-text/50 text-xl mb-2">No pieces published here yet.</p>
        <p class="font-sans text-brand-text/40 text-sm">Still exploring these thoughts.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const posts = document.querySelectorAll('.post-item');
    const featuredSection = document.getElementById('featured-section');
    const emptyState = document.getElementById('empty-state');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active styling
        buttons.forEach(b => b.classList.remove('text-brand-text'));
        btn.classList.add('text-brand-text');

        const filter = btn.getAttribute('data-filter');

        // Hide Featured section if a specific filter is selected
        if (featuredSection) {
          featuredSection.style.display = (filter === 'All') ? 'block' : 'none';
        }

        let visibleCount = 0;
        posts.forEach(post => {
          const type = post.getAttribute('data-type');
          if (filter === 'All' || (type && type.toLowerCase() === filter.toLowerCase())) {
            post.style.display = '';
            visibleCount++;
          } else {
            post.style.display = 'none';
          }
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  });
</script>
