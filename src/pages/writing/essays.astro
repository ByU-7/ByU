---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allWriting = await getCollection('writing');
const essays = allWriting.filter(p => {
  const t = (p.data.type || '').toLowerCase();
  return t === 'essay' || t === 'opinion' || t === 'article';
});

essays.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredEssay = essays.find(p => p.data.isFeatured) || essays[0];
const otherEssays = essays.filter(p => p.id !== featuredEssay?.id);
---

<Layout title="Essays & Articles | Bayu Distira">
  <div class="py-16 max-w-4xl mx-auto px-4 md:px-0">
    <div class="mb-16 text-center border-b border-brand-text/10 pb-16">
      <div class="text-xs font-sans tracking-[0.25em] uppercase text-brand-text/40 mb-3">
        <a href="/writing" class="hover:text-brand-accent transition-colors">Writing</a> &middot; Essays
      </div>
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-text mb-6">ESSAYS &amp; ARTICLES</h1>
      <p class="font-sans text-brand-text/60 text-lg max-w-xl mx-auto">Structured thinking, opinions, and longer reflections on society, technology, and existence.</p>
      
      {/* Subpage Switcher */}
      <div class="mt-12 flex flex-wrap justify-center gap-6 text-sm font-sans tracking-widest uppercase text-brand-text/40">
        <a href="/writing" class="hover:text-brand-text transition-colors">All</a>
        <a href="/writing/essays" class="text-brand-text font-bold border-b border-brand-text pb-1">Essays</a>
        <a href="/writing/prose" class="hover:text-brand-text transition-colors">Prose</a>
        <a href="/writing/notes" class="hover:text-brand-text transition-colors">Notes</a>
      </div>
    </div>

    {/* FEATURED ESSAY */}
    {featuredEssay && (
      <div class="mb-24">
        <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase mb-8 text-center md:text-left">Featured Essay</h2>
        <a href={`/writing/${featuredEssay.id}/`} class="block group">
          <article class="bg-[#e6e2d6] border border-brand-text/10 p-8 md:p-12 shadow-[0_10px_30px_-15px_rgba(0,0,0,0.1)] hover:shadow-[0_15px_40px_-15px_rgba(0,0,0,0.15)] hover:-translate-y-1 transition-all duration-300 rounded-lg">
            <h3 class="text-3xl md:text-4xl font-serif font-bold text-brand-text mb-4 group-hover:text-brand-accent transition-colors">{featuredEssay.data.title}</h3>
            <p class="font-sans text-brand-text/70 text-lg mb-8 leading-relaxed max-w-2xl">{featuredEssay.data.description}</p>
            <div class="flex items-center gap-2 text-xs font-sans tracking-[0.2em] uppercase text-brand-text/50">
              <span class="font-bold text-brand-accent">{featuredEssay.data.type}</span>
              {featuredEssay.data.tags && featuredEssay.data.tags.length > 0 && (
                <>
                  <span>&middot;</span>
                  <span>{featuredEssay.data.tags.join(', ')}</span>
                </>
              )}
              <span>&middot;</span>
              <span>{new Date(featuredEssay.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
          </article>
        </a>
      </div>
    )}

    {/* ALL ESSAYS LIST */}
    <div>
      <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase border-b border-brand-text/10 pb-4 mb-8">All Essays</h2>
      <div class="space-y-4">
        {otherEssays.map((post) => (
          <a href={`/writing/${post.id}/`} class="group block py-6 border-b border-brand-text/5 hover:bg-white/30 transition-colors px-4 -mx-4 rounded-lg">
            <article class="grid grid-cols-1 md:grid-cols-[1fr_200px] gap-4 md:items-center">
              <div>
                <div class="flex items-center gap-2 text-[10px] font-sans tracking-[0.2em] uppercase text-brand-text/50 mb-2">
                  <span class="font-bold text-brand-accent">{post.data.type}</span>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <>
                      <span>&middot;</span>
                      <span>{post.data.tags.join(', ')}</span>
                    </>
                  )}
                </div>
                <h3 class="text-2xl font-serif font-bold text-brand-text mb-2 group-hover:text-brand-accent transition-colors">{post.data.title}</h3>
                <p class="font-sans text-brand-text/60 text-sm max-w-2xl">{post.data.description}</p>
              </div>
              <div class="text-left md:text-right">
                <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-brand-text/40">
                  {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                    month: 'short', day: 'numeric', year: 'numeric'
                  })}
                  <br class="hidden md:block" />
                  <span class="md:hidden"> &middot; </span>
                  <span class="mt-1 inline-block">5 min read</span>
                </p>
              </div>
            </article>
          </a>
        ))}

        {essays.length === 0 && (
          <div class="text-center py-24">
            <p class="font-serif italic text-brand-text/50 text-xl mb-2">No essays published yet.</p>
            <p class="font-sans text-brand-text/40 text-sm">Drafts are currently brewing.</p>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
