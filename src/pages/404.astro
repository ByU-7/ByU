---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found | Bayu Distira">
  <div class="py-32 max-w-2xl mx-auto text-center px-4 flex flex-col items-center justify-center min-h-[60vh]">
    <h1 class="text-6xl md:text-8xl font-serif font-bold text-brand-text mb-6">404</h1>
    <p class="font-serif italic text-brand-text/60 text-xl md:text-2xl mb-8">
      You've wandered a bit too far.
    </p>
    <p class="font-sans text-brand-text/80 mb-12 max-w-md mx-auto leading-relaxed">
      The page you are looking for doesn't exist, has been moved, or perhaps it was just a fleeting thought that never made it into writing.
    </p>
    <a href="/" class="inline-block px-8 py-4 bg-brand-text text-brand-bg font-sans text-xs uppercase tracking-widest font-bold rounded-sm hover:bg-brand-accent transition-colors">
      Find Your Way Back
    </a>
  </div>
</Layout>
