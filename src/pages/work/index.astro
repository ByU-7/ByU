---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const work = await getCollection('work');
work.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = work.find(p => p.data.isFeatured) || work[0];
const selected = work.filter(p => p.id !== featured.id);
---

<Layout title="Things I Build | Bayu Distira">
  <div class="py-16 max-w-5xl mx-auto">
    <div class="mb-24 text-center border-b border-brand-text/10 pb-16">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-brand-text mb-6">WORK</h1>
      <p class="font-sans text-brand-text/60 text-lg">Things I've built, experimented with, and learned from.</p>
    </div>

    {/* FEATURED PROJECT */}
    {featured && (
      <div class="mb-32">
        <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase mb-12 text-center">Featured Project</h2>
        
        <div class="relative w-full max-w-4xl mx-auto mt-8">
          <a href={`/work/${featured.id}/`} class="group block">
            {/* The Image Box */}
            <div class="w-full md:w-[85%] aspect-[16/10] bg-[#e6e2d6] border border-brand-text/10 rounded-lg shadow-sm group-hover:shadow-md transition-shadow flex items-center justify-center overflow-hidden relative">
               <div class="text-brand-text/30 font-serif italic text-2xl">[ Featured Visual Here ]</div>
            </div>
            
            {/* The Overlapping Text Box */}
            <div class="md:absolute md:-bottom-12 md:-right-4 md:w-[45%] bg-brand-bg border border-brand-text/10 p-8 md:p-12 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] mt-8 md:mt-0 group-hover:-translate-y-2 transition-transform duration-500 rounded-sm">
              <h3 class="text-3xl font-serif font-bold text-brand-text mb-3 group-hover:text-brand-accent transition-colors">{featured.data.title}</h3>
              <p class="font-sans text-brand-text/70 mb-8 leading-relaxed">{featured.data.description}</p>
              <div class="mt-8 pt-6 border-t border-brand-text/10 flex justify-between items-center text-xs font-sans tracking-[0.2em] uppercase">
                <span class="text-brand-text/50">Web App &middot; {new Date(featured.data.pubDate).getFullYear()}</span>
                <span class="text-brand-accent group-hover:text-brand-text transition-colors flex items-center gap-2">Read Case Study <span class="group-hover:translate-x-1 transition-transform">&rarr;</span></span>
              </div>
            </div>
          </a>
        </div>
      </div>
    )}

    {/* SELECTED WORK */}
    <div class="border-t border-brand-text/10 pt-24 mt-40">
      <h2 class="text-xs font-sans font-bold tracking-[0.2em] text-brand-text/50 uppercase mb-20 text-center">Selected Work</h2>
      
      <div class="relative w-full pb-64">
        {selected.map((project, index) => (
          <div class="sticky w-full transition-all duration-500" style={`top: calc(120px + ${index * 40}px); z-index: ${10 + index};`}>
            <a href={`/work/${project.id}/`} class={`group flex flex-col md:flex-row items-center gap-10 md:gap-20 ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''} bg-brand-bg shadow-[0_-20px_40px_-20px_rgba(0,0,0,0.05)] border-t border-brand-text/5 py-16 md:py-24 px-4 -mx-4 md:px-12 md:-mx-12 rounded-t-3xl mt-12`}>
              {/* Image */}
              <div class="w-full md:w-1/2 aspect-square md:aspect-[4/3] bg-[#e6e2d6] border border-brand-text/10 rounded-lg shadow-sm group-hover:shadow-md transition-all duration-500 group-hover:scale-[1.02] flex items-center justify-center relative overflow-hidden">
                <div class="text-brand-text/30 font-serif italic">[ Project Visual ]</div>
              </div>
              
              {/* Text */}
              <div class="w-full md:w-1/2 flex flex-col justify-center">
                <h3 class="text-3xl font-serif font-bold text-brand-text mb-4 group-hover:text-brand-accent transition-colors">{project.data.title}</h3>
                <p class="font-sans text-brand-text/70 text-lg mb-8 leading-relaxed">{project.data.description}</p>
                
                <div class="mt-2 pt-6 border-t border-brand-text/5 flex justify-between items-center text-xs font-sans tracking-[0.2em] uppercase">
                  <span class="text-brand-text/50">{new Date(project.data.pubDate).getFullYear()} &middot; Project</span>
                  <span class="text-brand-accent group-hover:text-brand-text transition-colors flex items-center gap-2">Explore <span class="group-hover:translate-x-1 transition-transform">&rarr;</span></span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
    
  </div>
</Layout>
