---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import customHighlights from '../../data/highlights.json';

interface PhotoItem {
  img: string;
  date: string;
  timestamp: number;
}

const highlightsDir = path.resolve('./public/highlights');
const localPhotos: PhotoItem[] = [];

if (fs.existsSync(highlightsDir)) {
  const allowedExts = ['.jpg', '.jpeg', '.png', '.webp', '.gif', '.avif'];
  const files = fs.readdirSync(highlightsDir);

  for (const file of files) {
    const ext = path.extname(file).toLowerCase();
    if (!allowedExts.includes(ext)) continue;

    const fullPath = path.join(highlightsDir, file);
    const stats = fs.statSync(fullPath);

    // Cek apakah ada tanggal manual/kustom di highlights.json
    const customEntry = customHighlights.find(
      (item) => item.file === file || item.file === `/highlights/${file}`
    );

    if (customEntry) {
      localPhotos.push({
        img: `/highlights/${file}`,
        date: customEntry.date,
        timestamp: new Date(customEntry.date).getTime() || stats.mtimeMs,
      });
    } else {
      // Otomatis: format tanggal dari waktu modifikasi file
      const formattedDate = stats.mtime.toLocaleDateString('en-GB', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
      });

      localPhotos.push({
        img: `/highlights/${file}`,
        date: formattedDate,
        timestamp: stats.mtimeMs,
      });
    }
  }
}

// Foto eksternal/URL dari highlights.json
const externalPhotos: PhotoItem[] = customHighlights
  .filter((item) => item.file.startsWith('http://') || item.file.startsWith('https://'))
  .map((item) => ({
    img: item.file,
    date: item.date,
    timestamp: new Date(item.date).getTime() || 0,
  }));

// Gabungkan semua foto (lokal yang otomatis & kustom) dan urutkan dari yang terbaru
const photos = [...localPhotos, ...externalPhotos].sort((a, b) => b.timestamp - a.timestamp);
---

<Layout title="Highlights | Wander | Bayu Distira">
  <div class="py-12 max-w-5xl mx-auto px-4 md:px-0">
    
    {/* HEADER */}
    <div class="mb-12 text-center border-b border-brand-text/10 pb-10">
      <div class="text-[10px] font-sans tracking-[0.25em] uppercase text-brand-text/40 mb-2">
        <a href="/wander" class="hover:text-brand-accent transition-colors">&larr; Wander</a> &middot; Highlights
      </div>
      <h1 class="text-3xl md:text-4xl font-serif font-bold text-brand-text mb-3 tracking-wide">HIGHLIGHTS</h1>
      <p class="font-sans text-brand-text/50 text-sm">
        Arsip foto acak &amp; momen yang terekam.
      </p>
    </div>

    {/* COMPACT PHOTO GRID */}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
      {photos.map((photo, index) => (
        <div class="group flex flex-col cursor-pointer photo-item" data-index={index} data-img={photo.img} data-date={photo.date}>
          <div class="relative w-full aspect-square bg-brand-text/5 rounded-lg overflow-hidden border border-brand-text/10 group-hover:border-brand-text/30 transition-all duration-300">
            <img 
              src={photo.img} 
              alt={`Photo ${photo.date}`} 
              class="w-full h-full object-cover grayscale-[10%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500" 
              loading="lazy"
            />
            {/* Subtle overlay with date on hover */}
            <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-2.5">
              <span class="text-[10px] font-sans tracking-widest uppercase text-white font-medium drop-shadow-sm">
                {photo.date}
              </span>
            </div>
          </div>
          <span class="text-[10px] font-sans tracking-widest uppercase text-brand-text/40 text-center mt-1.5 group-hover:text-brand-text/70 transition-colors">
            {photo.date}
          </span>
        </div>
      ))}

      {photos.length === 0 && (
        <div class="col-span-full text-center py-20">
          <p class="font-serif italic text-brand-text/50 text-lg">Belum ada foto yang ditambahkan.</p>
          <p class="font-sans text-brand-text/40 text-xs mt-2">Taruh file foto di folder public/highlights/ untuk menambahkannya secara otomatis.</p>
        </div>
      )}
    </div>

    {/* LIGHTBOX MODAL */}
    <div id="lightbox" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm hidden items-center justify-center p-4">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white text-3xl font-sans cursor-pointer transition-colors p-2" aria-label="Close modal">&times;</button>
      <div class="max-w-4xl max-h-[85vh] flex flex-col items-center">
        <img id="lightbox-img" src="" alt="Full photo" class="max-w-full max-h-[78vh] object-contain rounded-lg shadow-2xl" />
        <p id="lightbox-date" class="text-xs font-sans tracking-widest uppercase text-white/70 mt-3"></p>
      </div>
    </div>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.photo-item');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxDate = document.getElementById('lightbox-date');
    const closeBtn = document.getElementById('lightbox-close');

    if (!lightbox || !lightboxImg || !lightboxDate) return;

    items.forEach(item => {
      item.addEventListener('click', () => {
        const img = item.getAttribute('data-img');
        const date = item.getAttribute('data-date');
        if (img) {
          lightboxImg.src = img;
          lightboxDate.textContent = date || '';
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          document.body.style.overflow = 'hidden';
        }
      });
    });

    const closeLightbox = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.src = '';
      document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  });
</script>
